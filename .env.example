# Postgres connection string (Supabase or Neon in production; local Postgres in dev)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Supabase Storage for photo attachments (§2/§7). Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the browser
# or commit a real value. See README "Photos" for the one-time bucket setup.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments
